# ==========================================
# ROSPL Configuration Environment Variables
# ==========================================

# Ollama Local LLM Configuration
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT=180

# Selenium Browser Configuration
BROWSER_HEADLESS=false
SELENIUM_TIMEOUT=15

# Firebase Configuration (Optional - provides Firestore persistence & Firebase Auth)
# Set FIREBASE_ENABLED=false for offline/local mode even if an old service-account file exists.
FIREBASE_ENABLED=true
# Option A: Service Account JSON file path
FIREBASE_SERVICE_ACCOUNT_PATH=serviceAccountKey.json
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com

# Option B: Web API Key (for Firebase REST Auth)
FIREBASE_WEB_API_KEY=AIzaSyYourApiKeyHere

# Option C: Environment credentials
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project-id.iam.gserviceaccount.com

# ==========================================
# Email Automation
# ==========================================
# Use demo for local fixtures/tests. It never sends external messages.
# Use gmail for OAuth-backed Gmail read/send operations.
EMAIL_PROVIDER=demo
GMAIL_CREDENTIALS_FILE=credentials.json
GMAIL_TOKEN_FILE=gmail_token.json
EMAIL_MAX_ATTACHMENT_MB=25
EMAIL_SEARCH_LIMIT=25
EMAIL_INBOX_FILE=demo_data/emails.json
EMAIL_SENT_FILE=demo_data/sent_emails.json
